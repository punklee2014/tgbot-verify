# Telegram Bot 配置
BOT_TOKEN=YOUR_BOT_TOKEN_HERE
CHANNEL_USERNAME=your_channel
CHANNEL_URL=https://t.me/your_channel
ADMIN_USER_ID=123456789

# MySQL 数据库配置
# 使用自带 docker-compose.yml 时，MYSQL_HOST 必须写 mysql（容器服务名）
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=tgbot_user
MYSQL_PASSWORD=your_password_here
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=tgbot_verify

# 积分配置（可选，默认值在 config.py 中）
# VERIFY_COST=1
# CHECKIN_REWARD=1
# INVITE_REWARD=2
# REGISTER_REWARD=1

# 人机验证打码（SheerID 现在要求 Cloudflare Turnstile）
# 不填则认证会失败并提示缺少验证码；填了才会继续
# 支持 2captcha / capsolver / yescaptcha
CAPTCHA_PROVIDER=2captcha
CAPTCHA_API_KEY=
# CAPTCHA_SITEKEY=0x4AAAAAACaWNlR_tN9-HfHj
# CAPTCHA_TIMEOUT=180

# SheerID 专用代理（机房 IP 会被 fraudRulesReject，必须住宅/家宽 IP）
# 例：SHERID_PROXY=http://user:pass@1.2.3.4:8080
# 只影响 SheerID 的请求，Telegram 和打码平台直连
SHERID_PROXY=
